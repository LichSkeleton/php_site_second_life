# Where the same frontend is served (browser URL, with or without trailing slash)
APP_URL=http://localhost:8080
APP_PORT=8080
PHPMYADMIN_PORT=8081

# Host port mapped to MySQL inside Docker (PHP still uses DB_PORT=3306)
MYSQL_HOST_PORT=3307

# Database (inside Docker DB_HOST must be the compose service name: db)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=dinamic_site
DB_USER=blog_user
DB_PASSWORD=blog_pass
DB_ROOT_PASSWORD=root_pass
DB_CHARSET=utf8mb4

# Used by app/database/seed.php (first container start, or: docker compose exec app php app/database/seed.php --force)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@myblog.local
ADMIN_PASSWORD=admin123
DEMO_USERNAME=demo
DEMO_EMAIL=demo@myblog.local
DEMO_PASSWORD=user123
